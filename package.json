{
  "name": "redou-agent-workspace",
  "version": "0.3.4",
  "private": true,
  "description": "Redou Agent workspace. Powered by OpenAI Codex CLI as the local agent runtime.",
  "scripts": {
    "desktop": "npm --prefix apps/desktop start",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:build:win": "npm --prefix apps/desktop run build:win",
    "desktop:build:linux": "npm --prefix apps/desktop run build:linux",
    "desktop:test": "node --test --test-force-exit --test-reporter=dot ./apps/desktop/tests/*.test.cjs",
    "web:dev": "npm --prefix vendor/hermes/web run dev",
    "web:build": "npm --prefix vendor/hermes/web run build",
    "codex:check": "codex --version",
    "codex:install": "npm install -g @openai/codex"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/herb711/RedouAgent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/herb711/RedouAgent/issues"
  },
  "homepage": "https://github.com/herb711/RedouAgent#readme"
}
